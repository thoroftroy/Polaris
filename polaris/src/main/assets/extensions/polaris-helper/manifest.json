{
  "manifest_version": 2,
  "name": "Polaris page helper",
  "version": "1.0",
  "description": "Keeps the box you are typing in in view when the keyboard opens.",
  "browser_specific_settings": { "gecko": { "id": "polaris-helper@wonderdesk.dev" } },
  "content_scripts": [ { "matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_start" } ]
}
